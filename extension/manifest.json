{
  "manifest_version": 3,
  "name": "Dédale, sites sosies",
  "short_name": "Dédale",
  "version": "0.1.0",
  "description": "Prévient avant d'ouvrir un site qui imite Orbis Pay. Ne lit que l'adresse de la page.",
  "minimum_chrome_version": "116",
  "permissions": ["webNavigation", "declarativeNetRequest", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dédale : sites sosies évités",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  }
}
