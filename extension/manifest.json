{
  "manifest_version": 3,
  "name": "sAIfe, sites louches",
  "short_name": "sAIfe",
  "version": "0.2.0",
  "description": "Prévient avant d'ouvrir un site louche : sosie d'une marque, adresse qui cache son propriétaire. Ne lit que l'adresse de la page.",
  "minimum_chrome_version": "116",
  "permissions": ["webNavigation", "declarativeNetRequest", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "sAIfe : sites louches évités",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  }
}
